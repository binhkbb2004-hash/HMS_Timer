# hms_fpga.qsf : project Quartus san cho RTL tren DE2-70

set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C70F896C6
set_global_assignment -name TOP_LEVEL_ENTITY de2_70_top
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name VERILOG_FILE ../rtl/de2_70_top.v
set_global_assignment -name VERILOG_FILE ../rtl/hms_timer.v
set_global_assignment -name VERILOG_FILE ../rtl/reset_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/clock_divider.v
set_global_assignment -name VERILOG_FILE ../rtl/button_processor.v
set_global_assignment -name VERILOG_FILE ../rtl/button.v
set_global_assignment -name VERILOG_FILE ../rtl/control_fsm.v
set_global_assignment -name VERILOG_FILE ../rtl/timer_counter.v
set_global_assignment -name SDC_FILE hms_fpga.sdc

set_location_assignment PIN_AD15 -to CLOCK_50
set_location_assignment PIN_T29 -to KEY[0]
set_location_assignment PIN_T28 -to KEY[1]
